<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:orientation="vertical" android:background="#eef3fc">
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="打开查看网络状态" android:textColor="#182438" android:textSize="15sp" android:maxLines="2" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/widget_check" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="检查网络" />
        <Button android:id="@+id/widget_billing" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="计费中心" />
    </LinearLayout>
</LinearLayout>
