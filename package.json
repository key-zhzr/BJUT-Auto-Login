{
  "name": "bjut-auto-login",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "test:frontend": "node --experimental-strip-types scripts/test-update-utils.mjs && node --experimental-strip-types --test scripts/test-router-billing.mjs scripts/test-router-experience.mjs scripts/test-device-usage.mjs scripts/test-config-crypto.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:versions": "node scripts/check-versions.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "site:build": "node website/build.mjs",
    "site:test": "node --test website/downloads.test.mjs",
    "site:refresh-downloads": "node website/refresh-release.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "~2",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.6",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.11",
    "jsqr": "^1.4.0",
    "lucide": "^1.22.0",
    "marked": "^18.0.6",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.5",
    "@types/sortablejs": "^1.15.9",
    "typescript": "~5.6.2",
    "vite": "^6.4.3"
  }
}
